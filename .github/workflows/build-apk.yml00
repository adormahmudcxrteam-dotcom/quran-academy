name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract ZIP
        run: |
          mkdir -p extracted
          python3 -c 'import glob, zipfile; zips = sorted(glob.glob("*.zip")); assert zips, "No .zip file found"; z = "-Masum-main.zip" if "-Masum-main.zip" in zips else zips[0]; print("Extracting", z); zipfile.ZipFile(z).extractall("extracted")'
          rm -rf extracted/.github
          if [ -f extracted/settings.gradle.kts ]; then
            cp -a extracted/. .
          else
            ROOT_DIR=$(find extracted -maxdepth 3 -name "settings.gradle.kts" -print -quit | xargs -r dirname)
            test -n "$ROOT_DIR"
            cp -a "$ROOT_DIR"/. .
          fi
          rm -rf extracted

      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Decode Debug Keystore
        run: |
          if [ -f debug.keystore.base64 ]; then
            base64 -d debug.keystore.base64 > debug.keystore
          fi

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.3.1'

      - name: Build Debug APK
        run: gradle :app:assembleDebug --no-daemon

      - name: Prepare APK
        run: cp app/build/outputs/apk/debug/app-debug.apk QuranLearningAcademy.apk

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: QuranLearningAcademy-APK
          path: QuranLearningAcademy.apk

      - name: Publish APK Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: latest-apk
          name: Quran Learning Academy APK
          files: QuranLearningAcademy.apk
